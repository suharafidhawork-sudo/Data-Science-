    "def anagram(list):\n",
    "    for i in range(len(list)):\n",
    "        for j in range(i+1,len(list)):\n",
    "            for k in list[j]:\n",
    "                for e in list[i]:\n",
    "                    if k==e:\n",
    "                        return True"
   ]
