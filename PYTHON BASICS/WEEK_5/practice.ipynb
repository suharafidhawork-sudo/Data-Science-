    "SUM OF DIGITS IN AN GIVEN NUMBER"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7ec2dcf2",
   "metadata": {},
   "outputs": [],
   "source": [
    "n=123\n",
    "sum=0\n",
    "while n>0:\n",
    "    r=n%10\n",
    "    sum+=r\n",
    "    n=n//10\n",
    "print(\"sum of digits of \",n,\": \",sum)    \n",
    "    \n"
   ]
  }
